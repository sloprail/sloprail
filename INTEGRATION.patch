+// WriteFile puts a file into a project, creating the directories above it.
+//
+// For the state a project is in BEFORE a session runs — the files an agent will
+// go on to edit or delete. What the agent itself does belongs in a scenario, so
+// that it travels through the tool calls a harness reports rather than being
+// arranged behind the engine's back.
+func (e *Env) WriteFile(projDir, rel, body string) {
+	e.t.Helper()
+	full := filepath.Join(projDir, rel)
+	if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+		e.t.Fatalf("harness: mkdir for %s: %v", rel, err)
+	}
+	if err := os.WriteFile(full, []byte(body), 0o644); err != nil {
+		e.t.Fatalf("harness: write %s: %v", rel, err)
+	}
+}
+
+// Exists reports whether a path is present in a project.
+//
+// How a test asks what actually happened to the tree, as opposed to what came
+// back on the stream. Whether a message travelled says nothing about whether a
+// write landed, and "the work was prevented" is a claim about the tree.
+func (e *Env) Exists(projDir, rel string) bool {
+	e.t.Helper()
+	_, err := os.Stat(filepath.Join(projDir, rel))
+	if err == nil {
+		return true
+	}
+	if !os.IsNotExist(err) {
+		e.t.Fatalf("harness: stat %s: %v", rel, err)
+	}
+	return false
+}
+
+// BlockingErrors returns the reasons attached to the conversation when a hook
+// refused to let the turn end.
+//
+// Scoped to the blocking attachments rather than the whole record, because the
+// record holds far more than what the agent was told: a guardrail's own folder
+// path travels on every hook payload, so searching the file for a guardrail's
+// NAME finds it whether or not the refusal ever named it. A test meaning to
+// assert that a refusal is actionable has to read the refusal, not the file.
+func (e *Env) BlockingErrors(projDir, sessionID string) []string {
+	e.t.Helper()
+	body, err := os.ReadFile(e.transcriptPath(projDir, sessionID))
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		e.t.Fatalf("harness: read transcript: %v", err)
+	}
+
+	var reasons []string
+	for _, line := range strings.Split(string(body), "\n") {
+		if !strings.Contains(line, `"hook_blocking_error"`) {
+			continue
+		}
+		var rec struct {
+			Attachment struct {
+				BlockingError struct {
+					BlockingError string `json:"blockingError"`
+				} `json:"blockingError"`
+			} `json:"attachment"`
+		}
+		if err := json.Unmarshal([]byte(line), &rec); err != nil {
+			continue
+		}
+		if r := rec.Attachment.BlockingError.BlockingError; r != "" {
+			reasons = append(reasons, r)
+		}
+	}
+	return reasons
+}
+
+// TranscriptHas reports whether the conversation's own record holds the text.
+//
+// The other place a hook's words can reach the agent, and for a Stop hook it is
+// the only one: a refusal that blocks the turn arrives as a hook_blocking_error
+// attachment in the record, which is what the agent reads on its next turn.
+// None of it appears on the stream the mock prints, so a test watching only
+// that cannot tell a refusal the agent was given from one it was not.
+//
+// The distinction is not academic. Of the channels that block a Stop, several
+// deliver no text at all — an engine using one of those leaves the agent
+// stopped with nothing to act on, which is worse than permitting the work.
+func (e *Env) TranscriptHas(projDir, sessionID, want string) bool {
+	e.t.Helper()
+	body, err := os.ReadFile(e.transcriptPath(projDir, sessionID))
+	if os.IsNotExist(err) {
+		return false
+	}
+	if err != nil {
+		e.t.Fatalf("harness: read transcript: %v", err)
+	}
+	return strings.Contains(string(body), want)
+}
