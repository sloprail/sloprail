{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./hooks/sr-session-hook-cursor.sh start", "timeout": 3600 }
    ],
    "preToolUse": [
      { "command": "./hooks/sr-session-hook-cursor.sh pre-tool", "timeout": 3600 }
    ],
    "postToolUse": [
      { "command": "./hooks/sr-session-hook-cursor.sh post-tool", "timeout": 60 }
    ],
    "postToolUseFailure": [
      { "command": "./hooks/sr-session-hook-cursor.sh post-tool", "timeout": 60 }
    ],
    "beforeReadFile": [
      { "command": "./hooks/sr-session-hook-cursor.sh post-tool", "timeout": 60 }
    ],
    "stop": [
      { "command": "./hooks/sr-session-hook-cursor.sh stop", "timeout": 3600 }
    ],
    "subagentStart": [
      { "command": "./hooks/sr-session-hook-cursor.sh subagent-start", "timeout": 60 }
    ],
    "subagentStop": [
      { "command": "./hooks/sr-session-hook-cursor.sh subagent-stop", "timeout": 3600 }
    ]
  }
}
