{
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sloprail session start" }] }
    ],
    "PreToolUse": [
      { "matcher": "Write", "hooks": [{ "type": "command", "command": "sloprail session pre-tool" }] },
      { "matcher": "Edit", "hooks": [{ "type": "command", "command": "sloprail session pre-tool" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "sloprail session pre-tool" }] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sloprail session stop" }] }
    ]
  }
}
