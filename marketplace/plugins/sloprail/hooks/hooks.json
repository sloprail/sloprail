{
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "SR_PLUGIN_DIRS=\"${CLAUDE_PLUGIN_ROOT}${SR_PLUGIN_DIRS:+:$SR_PLUGIN_DIRS}\" sr-session start" }] }
    ],
    "PreToolUse": [
      { "matcher": "Write", "hooks": [{ "type": "command", "command": "SR_PLUGIN_DIRS=\"${CLAUDE_PLUGIN_ROOT}${SR_PLUGIN_DIRS:+:$SR_PLUGIN_DIRS}\" sr-session pre-tool" }] },
      { "matcher": "Edit", "hooks": [{ "type": "command", "command": "SR_PLUGIN_DIRS=\"${CLAUDE_PLUGIN_ROOT}${SR_PLUGIN_DIRS:+:$SR_PLUGIN_DIRS}\" sr-session pre-tool" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "SR_PLUGIN_DIRS=\"${CLAUDE_PLUGIN_ROOT}${SR_PLUGIN_DIRS:+:$SR_PLUGIN_DIRS}\" sr-session pre-tool" }] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "SR_PLUGIN_DIRS=\"${CLAUDE_PLUGIN_ROOT}${SR_PLUGIN_DIRS:+:$SR_PLUGIN_DIRS}\" sr-session stop" }] }
    ],
    "SubagentStop": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "SR_PLUGIN_DIRS=\"${CLAUDE_PLUGIN_ROOT}${SR_PLUGIN_DIRS:+:$SR_PLUGIN_DIRS}\" sr-session subagent-stop" }] }
    ]
  }
}
