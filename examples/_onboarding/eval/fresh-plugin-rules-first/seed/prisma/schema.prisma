datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  createdAt DateTime  @default(now())
  orders    Order[]
  invoices  Invoice[]
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  totalCents  Int
  status      String
  createdAt   DateTime @default(now())
  invoice     Invoice?
}

model Invoice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  amountCents Int
  status      String
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?
}
