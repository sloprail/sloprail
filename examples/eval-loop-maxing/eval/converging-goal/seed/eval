#!/usr/bin/env python3
# `eval` — the real evaluator this project's eval-loop-maxing convention
# tracks (context/recording matches any invocation naming this binary).
# Scores classify() against a fixed labeled set, appends the result to
# evals/metrics.jsonl, and writes a run artifact under evals/runs/ whose
# path this prints on stdout.
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from classify import classify

CASES = [
    ("You won a free trip!", "spam"),
    ("Claim your prize now", "spam"),
    ("You are a WINNER, click to claim", "spam"),
    ("Free money waiting for you", "spam"),
    ("Let's meet for lunch tomorrow", "ham"),
    ("Meeting notes attached", "ham"),
    ("Reminder: dentist appointment Friday", "ham"),
    ("Can you review my prize-winning short story?", "ham"),
]

correct = sum(1 for text, want in CASES if classify(text) == want)
accuracy = correct / len(CASES)

os.makedirs("evals/runs", exist_ok=True)
os.makedirs("evals", exist_ok=True)

run_id = f"run-{int(time.time())}-{os.getpid()}"
run_path = f"evals/runs/{run_id}.json"
with open(run_path, "w") as f:
    json.dump({"run_id": run_id, "scores": {"accuracy": accuracy}}, f, indent=2)

with open("evals/metrics.jsonl", "a") as f:
    f.write(json.dumps({"run_id": run_id, "accuracy": accuracy}) + "\n")

print(run_path)
