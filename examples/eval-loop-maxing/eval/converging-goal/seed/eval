#!/usr/bin/env python3
# `eval` — the evaluator this project's eval-loop-maxing convention tracks
# (context/recording matches any invocation naming this binary).
#
# Scores classify() against the VISIBLE eval cases in cases.json (the ones
# this project's prompt and skill point the agent at) and appends the result
# to evals/metrics.jsonl. It does NOT touch the held-out set — that set is
# scored separately, by the goal-verify gate's own runner script, at Stop.
# This script is what the agent runs while iterating; the held-out score is
# not something the agent's own tool call can see or influence directly.
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from classify import classify

HERE = os.path.dirname(os.path.abspath(__file__))

with open(os.path.join(HERE, "cases.json")) as f:
    CASES = json.load(f)

correct = 0
for case in CASES:
    intent, _priority = classify(case["text"])
    if intent == case["intent"]:
        correct += 1
accuracy = correct / len(CASES)

os.makedirs("evals/runs", exist_ok=True)
os.makedirs("evals", exist_ok=True)

run_id = f"run-{int(time.time())}-{os.getpid()}"
run_path = f"evals/runs/{run_id}.json"
with open(run_path, "w") as f:
    json.dump({"run_id": run_id, "scores": {"accuracy": accuracy}}, f, indent=2)

with open("evals/metrics.jsonl", "a") as f:
    f.write(json.dumps({"run_id": run_id, "accuracy": accuracy}) + "\n")

print(run_path)
